<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->

        <TextView
            style="@style/Theme.GreenCart.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Green Points"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter"
            android:text="Earn points while shopping and redeem them for discounts."
            android:textColor="@color/md_theme_outline"
            android:textSize="14sp" />

        <!-- Points Card -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/md_theme_primaryContainer"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:text="Available Points"
                    android:textColor="@color/md_theme_onPrimaryContainer"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvPointsTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onPrimaryContainer"
                    android:fontFamily="@font/poppins"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="32sp"
                    android:autoSizeMaxTextSize="56sp"
                    android:autoSizeStepGranularity="2sp" />

                <TextView
                    android:text="Use your points at checkout to reduce your order total."
                    android:textColor="@color/md_theme_onPrimaryContainer"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Redeem Section -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/md_theme_surfaceContainerLow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:text="Redeem Points"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:fontFamily="@font/poppins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Redeem your Green Points during checkout to get instant discounts."
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRedeemPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Redeem Points"
                    android:layout_marginTop="12dp"
                    android:textAllCaps="false"
                    app:cornerRadius="50dp"
                    app:backgroundTint="@color/md_theme_primary"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Stats Section -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <!-- Spend Card -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerLow"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:text="Total Spend"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:fontFamily="@font/inter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvPointsSpent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rs. 0.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/md_theme_onSurface"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:autoSizeStepGranularity="1sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Orders Card -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerLow"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:text="Eligible Orders"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:fontFamily="@font/inter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvPointsOrders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/md_theme_onSurface"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeMaxTextSize="20sp"
                        android:autoSizeStepGranularity="1sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>