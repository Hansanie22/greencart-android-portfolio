<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/md_theme_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Next Delivery Date Badge -->
        <LinearLayout
            android:id="@+id/llNextDelivery"
            android:layout_width="64dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_quantity_selector"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvDeliveryMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAR"
                android:textSize="12sp"
                android:textColor="@color/md_theme_primary"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:letterSpacing="0.06"/>

            <TextView
                android:id="@+id/tvDeliveryDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textSize="26sp"
                android:textColor="@color/md_theme_onSurface"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>
        </LinearLayout>


        <!-- Subscription Details -->
        <LinearLayout
            android:id="@+id/llDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/llNextDelivery"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvSubName"
                style="@style/Theme.GreenCart.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Fresh Milk &amp; Eggs"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="17sp"
                android:maxLines="2"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/md_theme_primary"/>

                <TextView
                    android:id="@+id/tvFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Every Day • 7:00 AM"
                    android:textColor="@color/md_theme_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"/>
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_active_indicator"/>

                <TextView
                    android:id="@+id/tvSubStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Next delivery in 2 days"
                    android:textColor="@color/md_theme_outline"
                    android:textSize="12sp"
                    android:alpha="0.7"
                    android:fontFamily="@font/inter"/>
            </LinearLayout>

        </LinearLayout>


        <!-- Items Preview -->
        <LinearLayout
            android:id="@+id/llItemsPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:background="@drawable/bg_search_bar"
            app:layout_constraintTop_toBottomOf="@id/llDetails"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvItemCount"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="4 items"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="14sp"
                android:fontFamily="@font/inter"/>

            <TextView
                android:id="@+id/tvSubscriptionTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 450.00"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="16sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"/>
        </LinearLayout>


        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/md_theme_outline"
            android:alpha="0.08"
            app:layout_constraintTop_toBottomOf="@id/llItemsPreview"/>

        <!-- Skip Next Delivery -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipDelivery"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="Skip Next Delivery"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/md_theme_tertiary"
            app:strokeColor="@color/md_theme_tertiary"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/divider"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintTop_toBottomOf="@id/btnSkipDelivery">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkipNext"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Pause"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/md_theme_error"
                app:cornerRadius="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditSchedule"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Edit Items"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/md_theme_primary"
                app:cornerRadius="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDetails"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Stop"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/md_theme_error"
                app:strokeColor="@color/md_theme_error"
                app:strokeWidth="1dp"
                app:cornerRadius="14dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>