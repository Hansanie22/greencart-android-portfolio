<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="32dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_handle_bar"
        android:alpha="0.2"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filters"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:textColor="@color/md_theme_onSurface"
            android:letterSpacing="-0.02"/>

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:textSize="16sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/md_theme_primary"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"/>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort By"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:textColor="@color/md_theme_outline"
                android:textAllCaps="true"
                android:letterSpacing="0.05"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/sortChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="false"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortPopular"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Popular"
                    app:chipCornerRadius="12dp"
                    app:chipBackgroundColor="@color/md_theme_surfaceVariant"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortNewest"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Newest"
                    app:chipCornerRadius="12dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortPriceLow"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price Low → High"
                    app:chipCornerRadius="12dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortPriceHigh"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price High → Low"
                    app:chipCornerRadius="12dp"/>
            </com.google.android.material.chip.ChipGroup>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price Range"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/md_theme_outline"
                    android:textAllCaps="true"/>

                <TextView
                    android:id="@+id/txtPriceDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Rs. 0 - Rs. 5000"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary"/>
            </RelativeLayout>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/priceSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:valueFrom="0"
                android:valueTo="5000"
                app:thumbElevation="2dp"
                app:thumbRadius="12dp"
                app:trackHeight="4dp"
                app:thumbColor="@android:color/white"
                app:thumbStrokeColor="@color/md_theme_primary"
                app:thumbStrokeWidth="2dp"
                app:trackColorActive="@color/md_theme_primary"
                app:labelBehavior="gone"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:layout_marginTop="32dp"
                android:textColor="@color/md_theme_outline"
                android:textAllCaps="true"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/categoryChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="10dp">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥦 Vegetables"
                    app:chipCornerRadius="12dp"/>

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍎 Fruits"
                    app:chipCornerRadius="12dp"/>

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥛 Dairy"
                    app:chipCornerRadius="12dp"/>
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_apple_list_container"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:paddingHorizontal="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Show Deals Only"
                        android:textSize="16sp"
                        android:textColor="@color/md_theme_onSurface"
                        android:fontFamily="@font/inter"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDeals"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:trackDecorationTint="@color/md_theme_primary"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/md_theme_surfaceVariant"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:paddingHorizontal="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="In Stock Only"
                        android:textSize="16sp"
                        android:textColor="@color/md_theme_onSurface"
                        android:fontFamily="@font/inter"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchInStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="36dp"
                android:text="Show Results"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                app:cornerRadius="18dp"
                android:elevation="0dp"
                style="@style/Widget.Material3.Button"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>