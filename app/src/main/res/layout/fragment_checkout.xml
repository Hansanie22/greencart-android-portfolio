<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <!-- Header -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_background"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            app:tint="@color/md_theme_onBackground" />

        <TextView
            style="@style/Theme.GreenCart.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Checkout"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="20sp"
            android:letterSpacing="-0.01" />
    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/summaryCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Delivery Location Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery Location"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="22sp"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/md_theme_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvLocationTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Home"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="16sp"
                            android:letterSpacing="-0.01"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLocationAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="123 Main Street, Colombo 07"
                            android:textColor="@color/md_theme_outline"
                            android:textSize="14sp"
                            android:alpha="0.7"
                            android:fontFamily="@font/inter"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnChangeLocation"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_arrow"
                        app:tint="@color/md_theme_outline"
                        android:alpha="0.6" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddAnotherAddress"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="+ Add Another Address"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_primary" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbDifferentBilling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Billing address is different from delivery"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="14sp"
                android:fontFamily="@font/inter" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBillingAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/md_theme_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Billing Address"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBillingAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Same as delivery"
                            android:textColor="@color/md_theme_outline"
                            android:textSize="14sp"
                            android:alpha="0.7"
                            android:fontFamily="@font/inter"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnChangeBilling"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_arrow"
                        app:tint="@color/md_theme_outline"
                        android:alpha="0.6" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddBillingAddress"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="+ Add Billing Address"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_primary"
                android:visibility="gone" />

            <!-- Subscribe & Save -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSubscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/md_theme_primaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Subscribe &amp; Save"
                                android:textColor="@color/md_theme_onPrimaryContainer"
                                android:textSize="16sp"
                                android:letterSpacing="-0.01"
                                android:fontFamily="@font/poppins"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Free delivery + 5% off + bonus Green Points"
                                android:textColor="@color/md_theme_onPrimaryContainer"
                                android:textSize="13sp"
                                android:alpha="0.7"
                                android:fontFamily="@font/inter"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchSubscription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSubscriptionHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weekly delivery on Monday"
                        android:textColor="@color/md_theme_onPrimaryContainer"
                        android:textSize="13sp"
                        android:alpha="0.6"
                        android:fontFamily="@font/inter"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnEditSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose Schedule"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOfferClaim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/md_theme_primary"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvOfferTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Offer available"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:id="@+id/tvOfferHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Claim now to apply discount at checkout"
                        android:textColor="@color/md_theme_outline"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClaimOfferInCheckout"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:text="Claim Offer"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

                <!-- Promo Code Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPromoCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerLowest">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPromoCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Enter promo code"
                        app:hintTextColor="@color/md_theme_primary"
                        app:boxBackgroundMode="none"
                        app:hintEnabled="true"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="@id/btnClaimPromoCode"
                        app:layout_constraintEnd_toStartOf="@+id/btnClaimPromoCode"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/btnClaimPromoCode">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPromoCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/poppins"
                            android:inputType="textCapCharacters"
                            android:maxLines="1"
                            android:paddingVertical="10dp"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClaimPromoCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Apply"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPromoCodeFeedback"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/md_theme_error"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/btnClaimPromoCode"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

                <!-- Payment Method Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment Method"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="22sp"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <!-- Card Payment Option -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/md_theme_primary"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_card"
                        android:layout_marginStart="8dp"
                        app:tint="@color/md_theme_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Credit / Debit Card"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="16sp"
                            android:letterSpacing="-0.01"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCardDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Visa •••• 4242"
                            android:textColor="@color/md_theme_outline"
                            android:textSize="14sp"
                            android:alpha="0.7"
                            android:fontFamily="@font/inter"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnChangeCard"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_arrow"
                        app:tint="@color/md_theme_outline"
                        android:alpha="0.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cash on Delivery Option -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentCash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioCash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_money"
                        android:layout_marginStart="8dp"
                        app:tint="@color/md_theme_outline" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cash on Delivery"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="16sp"
                            android:letterSpacing="-0.01"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pay when you receive"
                            android:textColor="@color/md_theme_outline"
                            android:textSize="14sp"
                            android:alpha="0.7"
                            android:fontFamily="@font/inter"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Order Summary Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order Summary"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="22sp"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Subtotal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Items Subtotal"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:id="@+id/tvSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rs. 0.00"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <!-- Shipping Cost -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tvShippingLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Delivery Fee"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:id="@+id/tvShipping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rs. 300.00"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <!-- Subscription Discount (if enabled) -->
                    <LinearLayout
                        android:id="@+id/layoutDiscount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subscription Discount"
                            android:textColor="@color/md_theme_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:id="@+id/tvDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-Rs. 0.00"
                            android:textColor="@color/md_theme_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <!-- Promo Code Discount -->
                    <LinearLayout
                        android:id="@+id/layoutPromoDiscount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Promo Code"
                            android:textColor="@color/md_theme_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:id="@+id/tvPromoDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-Rs. 0.00"
                            android:textColor="@color/md_theme_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDiscountMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="@color/md_theme_outline"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Green Points"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:id="@+id/tvPointsBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Balance: 0 pts"
                            android:textColor="@color/md_theme_primary"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRedeemPoints"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Redeem points"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRedeemPoints"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnApplyPoints"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:text="Apply"
                            android:textAllCaps="false"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Points Redemption"
                            android:textColor="@color/md_theme_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:id="@+id/tvPointsRedeemValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-Rs. 0.00"
                            android:textColor="@color/md_theme_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/md_theme_outline"
                        android:alpha="0.2"
                        android:layout_marginVertical="12dp" />

                    <!-- Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="17sp"
                            android:letterSpacing="-0.01"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rs. 300.00"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="24sp"
                            android:letterSpacing="-0.02"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPayableHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Final payable amount"
                        android:textColor="@color/md_theme_outline"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Button Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/summaryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/md_theme_surface"
        android:layout_marginBottom="-16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlaceOrder"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Place Order"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:letterSpacing="0"
                android:fontFamily="@font/poppins"
                app:cornerRadius="14dp"
                android:elevation="0dp"
                app:elevation="0dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="By placing order you agree to our Terms"
                android:textColor="@color/md_theme_outline"
                android:textSize="12sp"
                android:alpha="0.6"
                android:fontFamily="@font/inter"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>