<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fitsSystemWindows="true"
    tools:context=".activity.SplashActivity">

    <!-- Logo Image - Centered -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logo"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.42"/>

    <!-- App Name - Using Poppins (Display font) -->
    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Green Cart"
        android:textSize="36sp"
        android:textColor="@color/md_theme_onBackground"
        android:fontFamily="@font/poppins_semibold"
        android:letterSpacing="-0.01"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/logoImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tagline - Using Poppins Medium -->
    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_medium"
        android:letterSpacing="0.12"
        android:text="ORGANIC &amp; FRESH"
        android:textColor="@color/md_theme_primary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appName" />

    <!-- Bottom Content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Progress Indicator -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true"
            app:indicatorSize="32dp"
            app:indicatorColor="@color/md_theme_primary"
            app:trackColor="@color/md_theme_surfaceVariant"
            app:trackThickness="3dp"
            android:layout_marginBottom="40dp"/>

        <!-- Version - Using Inter (Body font) -->
        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.0.0"
            android:textSize="11sp"
            android:textColor="@color/md_theme_outline"
            android:fontFamily="@font/inter"
            android:layout_marginBottom="6dp"/>

        <!-- Developer - Using Inter (Body font) -->
        <TextView
            android:id="@+id/developerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developed by Hansanie Prabodha"
            android:textSize="11sp"
            android:textColor="@color/md_theme_outline"
            android:fontFamily="@font/inter"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>